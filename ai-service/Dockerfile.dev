FROM python:3.12-slim

WORKDIR /app

# MediaPipe/OpenCV cần lib system
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# torch/torchvision: cài CPU wheel trước để tránh kéo CUDA (~vài GB) trên linux.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    torch torchvision
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# OpenCLIP weights (semantic search) — tải sẵn lúc build để container chạy
# không cần internet. Set HOME để OpenCLIP tìm cache đúng chỗ.
ARG CLIP_MODEL=ViT-B-32
ARG CLIP_PRETRAINED=laion2b_s34b_b79k
ENV HOME=/opt/clip-cache
RUN python scripts/download_clip_weight.py \
    --model "$CLIP_MODEL" \
    --pretrained "$CLIP_PRETRAINED" \
    --dir /opt/clip-cache

# YOLO26 weights (object detection) — bake sẵn, runtime không cần internet.
ARG YOLO_MODEL=yolo26n.pt
RUN python scripts/download_yolo_weight.py \
    --model "$YOLO_MODEL" \
    --dir /opt/yolo-cache

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]